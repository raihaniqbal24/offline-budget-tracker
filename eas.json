{
  "cli": { "version": ">= 12.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "development" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "release" }
    },
    "release": {
      "distribution": "internal",
      "channel": "release",
      "env": { "APP_VARIANT": "release" },
      "android": { "buildType": "apk" }
    }
  },
  "submit": { "production": {} }
}
